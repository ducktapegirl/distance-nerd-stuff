running-log/strava.html

# Python
__pycache__/
*.pyc

# tools/mobile_preview.py screenshot output
tools/preview-output/

# Netlify local link (deploy handled by GitHub Action)
.netlify

# Editor / temp / backups
*.bak-*
*.asv
*.autosave
Untitled.*

# Natural Earth download cache for tools/eink_route_maps.py / gen_routes.py
strava-data/assets/cache/
