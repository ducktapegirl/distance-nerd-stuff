# Claude local config (machine-specific; not shared)
.claude/settings.json
.claude/settings.local.json
.claude/launch.json

# Obsidian
.obsidian

# Strava secrets & generated/runtime artifacts
strava-data/.env
strava-data/.strava_tokens.json
strava-data/data/segments_map.html
strava-export/.env
strava-export/.strava_tokens.json

# Generated dashboards — built from data + Python in the deploy workflow,
# never committed (avoids data-vs-feature merge conflicts on pull).
running-log/index.html
running-log/strava.html
# E-paper feed outputs - same rule, built by strava-data/build_feed.py.
running-log/feed.xml
running-log/feed.json
running-log/epaper.html
running-log/epaper-all.html

# Python
__pycache__/
*.pyc

# tools/mobile_preview.py screenshot output
tools/preview-output/

# Netlify local link (deploy handled by GitHub Action)
.netlify

# Editor / temp / backups
*.bak-*
*.asv
*.autosave
Untitled.*
