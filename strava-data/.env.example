# Copy to strava-data/.env (gitignored) and fill in to build the Places hero /
# Activity-Details mini-map with real MapTiler basemap tiles locally. Leave empty
# and the build degrades to the tile-free "Glow" fallback (no key required).
# The key is embedded in the published static HTML, so a real key MUST be
# domain-restricted (ducktapegirl.github.io, plus 127.0.0.1 for local preview) in
# the MapTiler dashboard. In CI this is provided as a GitHub Actions secret.
MAPTILER_KEY=
